# Banco de Dados Postgres (Docker ou local)
DATABASE_URL=postgresql+psycopg://caged:caged@localhost:5432/caged

# Configurações do FTP do Novo CAGED
CAGED_FTP_HOST=ftp.mtps.gov.br
CAGED_FTP_BASE=/pdet/microdados/NOVO CAGED

# Escopo do projeto: Códigos IBGE de 6 dígitos separados por vírgula
# 270430 = Maceió, 270030 = Arapiraca
CAGED_MUNICIPIOS=270430,270030

# Janela temporal do projeto (Anos de início e fim)
CAGED_ANO_INICIO=2021
CAGED_ANO_FIM=2025
